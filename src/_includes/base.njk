            <svg viewBox="0 0 24 24" class="sw-search-box-icon" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="swSearchInput" class="sw-search-field" placeholder="Buscar cursos, especialidades o información (ej: vigilante, escolta, tiro, rural...)" autocomplete="off" />
