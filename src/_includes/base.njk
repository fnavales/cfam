              {% for navLink in nav.navLinks %}
              <li class="starwars-nav-entry{% if navLink.dropdown %} has-dropdown{% endif %}">
                {% if navLink.route == "home" %}
                  <a class="starwars-link" href="/">{{navLink.name | upper}}</a>
                {% else %}
                  <a class="starwars-link" href="/{{navLink.route}}">{{navLink.name | upper}}{% if navLink.dropdown %}<svg class="dropdown-arrow" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
                {% endif %}
                {% if navLink.dropdown %}
                <ul class="starwars-dropdown">
                  {% for item in navLink.dropdown %}
                  <li><a href="/{{item.route}}" class="starwars-dropdown-link">
                    <span class="dropdown-item-name">{{item.name}}</span>
                    {% if item.badge %}<span class="dropdown-item-badge">{{item.badge}}</span>{% endif %}
                  </a></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </li>
              {% endfor %}
            </ul>

            <!-- Sección inferior en menú móvil -->
